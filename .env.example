# 原生运行时：填写实际的绝对路径，程序必须匹配固定 SHA256。
CCRB_CLAUDE_BINARY=/absolute/path/to/claude.exe
CCRB_CLAUDE_HOME=/absolute/path/to/cc-runtime-bridge/runtime/home
CCRB_CLAUDE_CONFIG_DIR=/absolute/path/to/cc-runtime-bridge/runtime/config

# 凭据由操作者单独提供，测试不会使用真实账号。
# CCRB_NATIVE_API_KEY=
# CCRB_NATIVE_OAUTH_TOKEN=
# CCRB_PROXY_URL=http://127.0.0.1:8080
# CCRB_CA_FILE=/absolute/path/to/ca.pem

CCRB_HOST=127.0.0.1
CCRB_PORT=8787
CCRB_LOG_MODE=debug
CCRB_CAPTURE_BYTES=1048576
CCRB_LOG_BYTES=536870912
CCRB_RETAIN_DAYS=7
CCRB_DEBUG_RETAIN_DAYS=3
CCRB_TIMEOUT_MS=90000

# 页面预览可直接 bun run start --demo，无须提供以上程序与凭据。
